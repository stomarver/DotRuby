glyph-size(6x8) //размер парсируемой области по умолчанию
glyph-gap(1,1) //отступ между буквами
edge-gap(0,0) //отступ от краёв изображения
char-spacing(1,1) //доп расстояние между буквами при рендере
glyph-baseline(0) //смещение текста вниз (полезно для выравнивания по базовой линии)
spacing(2) //ширина пробела (теперь может быть 0 или отрицательной)

rows = (//порядок букв с переносом строки из текстуры
    AaBbCcDdEeFfGgHhIi
    JjKkLlMmNnOoPpQqRr
    SsTtUuVvWwXxYyZz
    АаБбВвГгДдЕеЖжЗзИи
    КкЛлМмНнОоПпРрСсТт
    УуФфХхЦцЧчШшЩщЪъЫы
    ЬьЭэЮюЯя
    0123456789+-=*()[]
    {}<>/\.,_:;!?`@#$%
    ^&
)

advances = ( //уникальные размеры
    MmTVWwДЖжМмТтФфЦцШшЪъ?#% = (5x8)
    AaBbCcDdEeFGgHhJjKkLNnOoPpQqRrSsUuvXxYyZzАаБбВвГдЕеЗзИиКкЛлНнОоПпРрСсУуХхЧчЬьЭэЯя023456789$ = (4x8)
    fItг+-{}<>/\1*^ = (3x8)
    l()[]` = (2x8)
    i!:; = (1x8)
)

diacritics = ( //пустышка
    acute      atlas(120,5)   size(4x3)   attach(+1,-2)
    grave      atlas(125,5)   size(4x3)   attach(+1,-2)
    circumflex atlas(130,5)   size(4x3)   attach(+1,-2)
    diaeresis  atlas(135,5)   size(4x3)   attach(+1,-2)
    dot-above  atlas(140,5)   size(2x2)   attach(+2,+1)
    macron     atlas(145,5)   size(5x1)   attach(+0,-3)
    breve      atlas(150,5)   size(4x2)   attach(+1,-1)
    caron      atlas(155,5)   size(4x3)   attach(+1,-2)
)
