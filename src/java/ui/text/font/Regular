atlas(assets/fonts/Regular.png) //путь к текстуре
size(6x8) //размер символа по умолчанию
gap(-1,1) //отступы между символами
letter-spacing(0) //расстояние между символами которое учитывается отрисовщиком
space-width(3) //длина пробела в пикселях

rows = ( //массив символов с переносом строки как 'String[] ROWS'
    AaBbCcDdEeFfGgHhIi
    JjKkLlMmNnOoPpQqRr
    SsTtUuVvWwXxYyZz
    АаБбВвГгДдЕеЖжЗзИи
    КкЛлМмНнОоПпРрСсТт
    УуФфХхЦцЧчШшЩщЪъЫы
    ЬьЭэЮюЯя
)

advances = ( //символы с уникальной шириной
    Iftг = 4
    l = 3
    i = 2
)

diacritics = ( //пока пустышка, не требует реализации в коде.
    acute      atlas(120,5)   size(4x3)   attach(+1,-2)
    grave      atlas(125,5)   size(4x3)   attach(+1,-2)
    circumflex atlas(130,5)   size(4x3)   attach(+1,-2)
    diaeresis  atlas(135,5)   size(4x3)   attach(+1,-2)
    dot-above  atlas(140,5)   size(2x2)   attach(+2,+1)
    macron     atlas(145,5)   size(5x1)   attach(+0,-3)
    breve      atlas(150,5)   size(4x2)   attach(+1,-1)
    caron      atlas(155,5)   size(4x3)   attach(+1,-2)
)
